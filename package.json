        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "prettier": "3.9.9",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.8.0",
        "vite": "^7.0.7",
        "vitest": "^5.0.1"
    },
    "dependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-router-dom": "^7.0.0"
